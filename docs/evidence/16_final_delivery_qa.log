import json,subprocess,math
f='results/final_results.json'
old=json.loads(subprocess.run(['git','show','HEAD:'+f],capture_output=True).stdout.decode('utf-8-sig')); new=json.load(open(f,encoding='utf-8-sig'))
def same(a,b): return a==b or (isinstance(a,float) and isinstance(b,float) and math.isnan(a) and math.isnan(b))
def walk(a,b,p=''):
    if isinstance(a,dict) and isinstance(b,dict):
        for k in sorted(set(a)|set(b)): yield from walk(a.get(k),b.get(k),p+'/'+str(k))
    elif isinstance(a,list) and isinstance(b,list) and len(a)==len(b):
        for i,(x,y) in enumerate(zip(a,b)): yield from walk(x,y,p+f'[{i}]')
    elif not same(a,b): yield p,a,b
d=list(walk(old,new)); print('final_results.json fields differing (NaN-aware):',len(d))
for p,a,b in d: print(' ',p,':',a,'->',b)
print('all differences inside error_analysis modal predictions:', all('/error_analysis/' in p for p,_,_ in d))
PY
