# Copy to .env and adjust. TX_ADMIN_TOKEN is a secret when set; never commit .env.

# Model registry (registry.json + versions/<id>/model weights)
TX_REGISTRY_DIR=model_registry
# Monitoring event log (no descriptions are ever written)
TX_MONITORING_DIR=monitoring
# MLflow: local SQLite file by default; e.g. http://mlflow:5000 for a server
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
TX_MLFLOW_ENABLED=true
# API
LOG_FORMAT=json
TX_LOG_LEVEL=INFO
TX_MAX_BATCH_SIZE=256
# Enables POST /model/reload (send as X-Admin-Token header) when set
TX_ADMIN_TOKEN=
# CPU threads used by PyTorch inference
OMP_NUM_THREADS=2
# Host interface for the published API port (docker compose). Default localhost only;
# use 0.0.0.0 only behind a TLS reverse proxy with authentication (SECURITY.md).
API_BIND=127.0.0.1
API_PORT=8000
# Optional: Hugging Face token only raises download rate limits; not required
# HF_TOKEN=
